{
  "name": "high-throughput-logger",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest",
    "load-test": "tsx load-test/run.ts",
    "load-test:smoke": "tsx load-test/run.ts --smoke",
    "check:partman": "tsx scripts/check-partman.ts",
    "check:retention": "tsx scripts/check-retention.ts",
    "premake:partitions": "tsx scripts/premake-partitions.ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "migrate:create": "dotenv -e .env -- npx tsx ./node_modules/node-pg-migrate/bin/node-pg-migrate.js create --migrations-dir src/DB/migrations --migration-filename-format index",
    "migrate:up": "dotenv -e .env -- npx tsx ./node_modules/node-pg-migrate/bin/node-pg-migrate.js up --migrations-dir src/DB/migrations",
    "migrate:down": "dotenv -e .env -- npx tsx ./node_modules/node-pg-migrate/bin/node-pg-migrate.js down --migrations-dir src/DB/migrations"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/pg-copy-streams": "^1.2.5",
    "dotenv-cli": "^11.0.0",
    "node-pg-migrate": "^9.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.5",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^12.0.3",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "pg-copy-streams": "^7.0.0"
  }
}
