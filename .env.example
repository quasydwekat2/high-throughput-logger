# ── App (src/config.ts + docker-compose.yml) ──────────────────────────────────
NODE_ENV=development
PORT=8080

# ── PostgreSQL (docker-compose.yml) ───────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=log_ingestion_db
POSTGRES_PORT=5432

# Host-local app (npm run dev). Inside Docker, compose overrides host to `postgres`.
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/log_ingestion_db

# ── Connection pools (src/config.ts) ──────────────────────────────────────────
PG_WRITE_POOL_MAX=1
PG_QUERY_POOL_MAX=2
PG_AGGREGATE_POOL_MAX=2
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=15000

# ── Ingest buffer (src/config.ts) ─────────────────────────────────────────────
INGEST_BUFFER_ENABLED=true
FLUSH_INTERVAL_MS=5
FLUSH_BATCH_SIZE=4000
FLUSH_CONCURRENCY=1
QUEUE_MAX_SIZE=100000

# Days to keep log partitions. Applied to pg_partman on app startup (default 30).
RETENTION_DAYS=30

# ── Load test (docker-compose load-test profile + load-test/config.ts) ────────
BASE_URL=http://localhost:8080
TARGET_LOGS_PER_SEC=15000
TOTAL_LOGS=1000000
BATCH_SIZE=500
CONCURRENCY=32
AGGREGATE_INTERVAL_MS=1000
QUERY_INTERVAL_MS=2000
VISIBILITY_DEADLINE_MS=20000
AGGREGATE_P95_MAX_MS=1000
WARMUP_SEC=5
HEALTH_TIMEOUT_MS=120000
PACE_FACTOR=1.05