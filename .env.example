# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=log_ingestion_db
POSTGRES_PORT=5432

# Used when running the app locally (outside Docker).
# Inside Docker, compose builds this URL from the variables above.
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/log_ingestion_db

# ── pgAdmin ───────────────────────────────────────────────────────────────────
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password_here
PGADMIN_PORT=5050

# ── Connection pool tuning ────────────────────────────────────────────────────
PG_POOL_MAX=14
# idle connection close timeout (ms)
PG_IDLE_TIMEOUT_MS=30000
# new connection acquire timeout (ms)
PG_CONNECTION_TIMEOUT_MS=5000

# ── Retention (pg_partman; fixed in migration 002 — not read by the app) ──────
RETENTION_DAYS=30

# ── Ingestion buffer ──────────────────────────────────────────────────────────
# Set INGEST_BUFFER_ENABLED=false for sync writes
INGEST_BUFFER_ENABLED=true
FLUSH_INTERVAL_MS=40
FLUSH_BATCH_SIZE=8000
FLUSH_CONCURRENCY=5
QUEUE_MAX_SIZE=500000
FLUSH_MAX_RETRIES=5

# ── Optional Auth (off by default) ───────────────────────────────────────────
AUTH_ENABLED=false
# LOADGEN_API_KEY=your-secret-key-here
