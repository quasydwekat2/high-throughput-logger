# Benchmark/runtime image: compile TypeScript, run node (no tsx watch).
FROM node:22-alpine

WORKDIR /usr/src/app

COPY package*.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src ./src
COPY public ./public
RUN npx tsc

ARG PORT=8080
EXPOSE ${PORT}

ENV NODE_ENV=production

CMD ["node", "dist/server.js"]
